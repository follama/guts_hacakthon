# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Gemini API key for the drawing judge.
# Free, no card needed: https://aistudio.google.com/apikey
# Without it the game still runs, but every drawing is kept unjudged.
GEMINI_API_KEY=

# Optional: judging models, tried in order if one is overloaded
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
